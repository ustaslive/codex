{
  "name": "Codex Local LLM",
  "dockerComposeFile": "compose.yaml",
  "service": "codex-dev",
  "workspaceFolder": "/workspace",
  "remoteUser": "ubuntu",
  "shutdownAction": "stopCompose",
  "overrideCommand": true,
  "customizations": {
    "vscode": {
      "settings": {
        "terminal.integrated.defaultProfile.linux": "bash",
        "terminal.integrated.env.linux": {
          "PATH": "/home/ubuntu/.cargo/bin:${env:PATH}"
        },
        "editor.formatOnSave": true,
        "files.watcherExclude": {
          "**/target/**": true,
          "**/.git/objects/**": true
        },
        "search.exclude": {
          "**/target/**": true,
          "**/.git/objects/**": true
        },
        "rust-analyzer.check.command": "clippy",
        "rust-analyzer.cargo.targetDir": true
      },
      "extensions": [
        "rust-lang.rust-analyzer",
        "tamasfe.even-better-toml",
        "vadimcn.vscode-lldb"
      ]
    }
  },
  "postCreateCommand": "sudo mkdir -p /workspace/codex-rs/target && sudo chown -R ubuntu:ubuntu /workspace/codex-rs/target && rustc --version && cargo --version && pkg-config --libs --cflags libcap"
}